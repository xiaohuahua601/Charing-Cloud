<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>


    <parent>
        <groupId>org.springframework.boot</groupId>
        <!--继承spring boot parent 2.7.14-->
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.14</version>
    </parent>


    <groupId>cn.tedu.charging</groupId>
    <artifactId>charging-cloud-vn2409</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <mysql-version>8.0.31</mysql-version>
        <mybatis-plus-version>3.5.2</mybatis-plus-version>
        <nacos-version>2021.0.4.0</nacos-version>
        <knife4j-version>4.3.0</knife4j-version>
        <open-feign-version>3.1.5</open-feign-version>
        <lb-version>3.1.5</lb-version>
        <mqtt-version>1.2.5</mqtt-version>
        <amqp-version>2.6.13</amqp-version>
        <websocket-version>2.7.14</websocket-version>
        <es-version>2.5.8</es-version>
        <quartz-version>2.3.2</quartz-version>
        <gateway-version>3.1.4</gateway-version>
    </properties>

    <modules>
        <module>charging-device</module>
        <module>charging-common</module>
        <module>charging-order</module>
        <module>charging-user</module>
        <module>charging-cost</module>
        <module>charging-gateway</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- 数据库驱动 链接数据库必备-->
            <dependency>
                <groupId>mysql</groupId>
                <artifactId>mysql-connector-java</artifactId>
                <version>${mysql-version}</version>
            </dependency>
            <!-- mybatis-plus 用来操作数据库-->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-boot-starter</artifactId>
                <version>${mybatis-plus-version}</version>
            </dependency>
            <!-- 用来连接和操作 nacos -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
                <version>${nacos-version}</version>
            </dependency>
            <!-- 小刀 用来生成api文档-->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi2-spring-boot-starter</artifactId>
                <version>${knife4j-version}</version>
            </dependency>
            <!--服务之间通信-->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-starter-openfeign</artifactId>
                <version>${open-feign-version}</version>
            </dependency>
            <!-- 负载均衡-->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-starter-loadbalancer</artifactId>
                <version>${lb-version}</version>
            </dependency>
            <!--连接emqx的客户端-->
            <dependency>
                <groupId>org.eclipse.paho</groupId>
                <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
                <version>${mqtt-version}</version>
            </dependency>
            <!--RabbitMQ消息中间件-->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-amqp</artifactId>
                <version>${amqp-version}</version>
            </dependency>
            <!--websocket 用来实现推送 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-websocket</artifactId>
                <version>${websocket-version}</version>
            </dependency>
            <!-- 数据存储用来存储充电进度数据-->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-data-elasticsearch</artifactId>
                <version>${es-version}</version>
            </dependency>
            <!--定时任务框架-->
            <dependency>
                <groupId>org.quartz-scheduler</groupId>
                <artifactId>quartz</artifactId>
                <version>${quartz-version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-starter-gateway</artifactId>
                <version>${gateway-version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>